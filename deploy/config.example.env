# Plantilla de configuración — despliegue local (estrategia C)
# Copiar a deploy/config.env (gitignored) y ajustar.
# NO poner contraseñas, rutas personales del hotel ni datos productivos reales.

# Perfil: dev | hotel
# hotel exige BM_DEMO_FILE o BM_INSTANCE_ROOT y prohíbe el demo canónico.
BM_DEPLOY_PROFILE=hotel

# Raíz de instancia (Windows provisional — confirmar in situ).
# Ejemplo: %LOCALAPPDATA%\BM-V2
# Espacios soportados si la ruta expandida los tiene.
BM_INSTANCE_ROOT=%LOCALAPPDATA%\BM-V2

# Alternativa explícita al JSON (si se omite, se usa %BM_INSTANCE_ROOT%\data\datos_hotel.json)
# BM_DEMO_FILE=%LOCALAPPDATA%\BM-V2\data\datos_hotel.json

# Vista Flet
BM_FLET_VIEW=desktop

# Exportaciones semanales automáticas en Streamlit (0/1)
BM_SKIP_WEEKLY_EXPORT=0

# Nunca dejar BM_DEPLOY_ALLOW_OPS=1 en config persistente de operador.
# Los scripts CLI lo activan solo durante backup/restore.
